# ── Inside a Fly.io Sprite ──────────────────────────────────────
# Connectors are auto-discovered from https://api.sprites.dev/v1/gateway/list
# You only need to override *_GATEWAY if you have multiple connections per provider.
# GITHUB_GATEWAY=
# TYPESAFE_GATEWAY=
# PINECONE_GATEWAY=
# AGENTMAIL_GATEWAY=
# ANTHROPIC_GATEWAY=
# OPENAI_GATEWAY=
# OLLAMA_GATEWAY=
# GEMINI_GATEWAY=

# Pinecone index name (created via Sprites Pinecone connector)
PINECONE_INDEX=harmedi
PINECONE_API_VERSION=2026-04

# ── Mutator Engine ──────────────────────────────────────────────
# auto | claude | codex | api
MUTATOR=auto
# Optional model overrides:
ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-4.1
# OLLAMA_MODEL=gpt-oss:120b
# GEMINI_MODEL=gemini-2.5-flash
# JEV_MODEL=jev-latest

# ── Identity & Repo ─────────────────────────────────────────────
# Your own GitHub repo for harmedi (owner/repo)
HARMEDI_REPO=ryssroad/harmedi
CREATOR_GITHUB=ryssroad
# AgentMail inbox & your email (set CREATOR_EMAIL to enable outbound emails)
HARMEDI_INBOX=alephzero@agentmail.to
# CREATOR_EMAIL=you@example.com

# ── Webhook Secrets (verified by cage/server.ts) ────────────────
# GITHUB_WEBHOOK_SECRET=
# AGENTMAIL_WEBHOOK_SECRET=whsec_...

# ── Cage / Evolution Tuning ─────────────────────────────────────
# Set to 1 inside a live Sprite to invoke `sprite-env checkpoints restore` on fatal mutations
AUTO_RESTORE_SPRITE=0
PORT=8080

# ── Local Dev Fallback (used ONLY outside a Sprite when no gateway exists) ──
# TYPESAFE_KEY=
# ANTHROPIC_KEY=
# OPENAI_KEY=
# OLLAMA_KEY=
# PINECONE_KEY=
# GITHUB_KEY=
# AGENTMAIL_KEY=
